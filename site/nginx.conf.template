map $http_x_forwarded_for $faza_visitor { "~(?:^|,)\s*([^,\s]+)\s*$" $1; default $remote_addr; }

# Site client FAZA 3D (nginx). Les ${FAZA_...} sont remplacées au démarrage par les variables d'environnement du conteneur.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  absolute_redirect off;
  # www.faza3d.tn → faza3d.tn, directement sur le serveur (même si la règle Cloudflare ne s'applique pas)
  if ($host ~* ^www\.(.+)$) { return 301 https://$1$request_uri; }
  client_max_body_size 1m;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/css application/javascript image/svg+xml application/json;

  # en-têtes de sécurité (le site appelle la plateforme pour le formulaire, l'assistant et l'espace client)
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: ${FAZA_PLATFORM_URL}; connect-src 'self' ${FAZA_PLATFORM_URL}; media-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' ${FAZA_PLATFORM_URL}; frame-ancestors 'none'" always;

  expires 1h;

  # réglages générés au démarrage : jamais en cache
  location = /config.js { expires -1; }
  # la page elle-même : toujours revalidée, une mise à jour du site est visible tout de suite
  location = /index.html { expires -1; }

  location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }

  # pas de fichiers cachés (.git, .env…)
  location ~ /\. { deny all; }

  # pages et API destinées aux clients (formulaire, suivi, devis, espace client, paiement) : relayées vers la plateforme,
  # pour que les clients ne voient que faza3d.tn (fichier écrit au démarrage, vide si FAZA_PLATFORM_URL n'est pas réglée)
  include /etc/nginx/faza-proxy.conf;

  # version arabe : même page, servie sous /ar/ avec son en-tête en arabe (langue, titre, description, adresse canonique)
  # pour que Google l'indexe comme une page à part (balises hreflang fr / ar)
  location = /ar { return 301 /ar/$is_args$args; }
  location = /ar/ {
    expires -1;
    gzip off;
    rewrite ^ /index.html break;
    sub_filter_once on;
    sub_filter '<html lang="fr">' '<html lang="ar" dir="rtl">';
    sub_filter '<title>FAZA 3D · Impression 3D et découpe laser à Tunis</title>' '<title>FAZA 3D · طباعة ثلاثية الأبعاد وقص بالليزر في تونس</title>';
    sub_filter '<link rel="canonical" href="https://faza3d.tn/">' '<link rel="canonical" href="https://faza3d.tn/ar/">';
    sub_filter '<meta property="og:url" content="https://faza3d.tn/">' '<meta property="og:url" content="https://faza3d.tn/ar/">';
    sub_filter '<meta property="og:locale" content="fr_TN">' '<meta property="og:locale" content="ar_TN">';
    sub_filter '<meta property="og:title" content="FAZA 3D · Impression 3D et découpe laser à Tunis">' '<meta property="og:title" content="FAZA 3D · طباعة ثلاثية الأبعاد وقص بالليزر في تونس">';
    sub_filter '<meta name="description" content="FAZA 3D, atelier d\'impression 3D' '<meta name="description" content="FAZA 3D، ورشة طباعة ثلاثية الأبعاد وقص ونقش بالليزر ومسح ثلاثي الأبعاد في تونس: كؤوس، لوحات منقوشة، هدايا مخصصة، مجسمات ونماذج أولية. عرض سعر مجاني خلال 24 ساعة." data-fr="';
    sub_filter '<meta property="og:description" content="Trophées' '<meta property="og:description" content="كؤوس، لوحات منقوشة، هدايا مخصصة، مجسمات ونماذج أولية. عرض سعر مجاني خلال 24 ساعة." data-fr="';
  }

  location / { try_files $uri $uri/ /index.html; }
}
