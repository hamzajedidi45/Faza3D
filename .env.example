# ============================================================================
#  FAZA 3D : variables d'environnement
#  EasyPanel : copiez les lignes utiles dans l'onglet « Environment » de chaque service.
#  docker compose (test local) : copiez ce fichier en .env et remplissez-le.
#  Une ligne vide = valeur par défaut. Ne mettez JAMAIS le fichier .env rempli dans git.
# ============================================================================

# ---------------------------------------------------------------------------
#  SERVICE « atelier » (la plateforme)
# ---------------------------------------------------------------------------

# Adresse publique de la plateforme (liens de suivi et de devis, QR des factures, retour des paiements en ligne)
FAZA_PUBLIC_URL=https://atelier.faza3d.tn

# Adresse(s) du site client autorisée(s) à appeler l'API publique, séparées par des virgules (* = toutes)
FAZA_CORS_ORIGINS=https://faza3d.tn,https://www.faza3d.tn

# Clé de chiffrement des mots de passe enregistrés (SMTP, clés API…). 64 caractères hexadécimaux.
# Générez-la une fois :  openssl rand -hex 32   et GARDEZ-LA (sans elle, les connexions sont à ressaisir).
FAZA_SECRET_KEY=

# Code demandé pour créer le compte administrateur la première fois (8 caractères minimum).
# Vide = un code aléatoire est affiché dans le journal (Logs) du service au démarrage.
FAZA_INSTALL_CODE=

# Imprimantes de l'atelier : identifiant:Nom, séparés par des virgules
FAZA_PRINTERS=x2d:X2D Combo,a2l:A2L Combo,p1s:P1S,a1:A1

# Derrière le proxy HTTPS d'EasyPanel (Traefik) : true (valeur par défaut de l'image)
FAZA_BEHIND_PROXY=true
# Nombre de proxys de confiance devant la plateforme : 1 (Traefik seul) ; 2 si Cloudflare (nuage orange) + Traefik
FAZA_TRUSTED_PROXY_HOPS=1
# Seulement si Cloudflare est devant (nuage orange) : cf-connecting-ip. Sinon VIDE (l'en-tête pourrait être falsifié).
FAZA_CLIENT_IP_HEADER=

# Plafonds de protection : réponses de l'assistant IA par jour, volume des fichiers déposés depuis le site par jour
FAZA_ASSISTANT_DAILY_LIMIT=500
FAZA_PUBLIC_UPLOAD_DAILY_MB=1024

# Jeton du relais des imprimantes (sinon il se crée dans Connexions › Relais). Générez-le : openssl rand -hex 24
FAZA_RELAY_TOKEN=

# --- Connexions (facultatif). Remplies ici, elles priment sur l'écran Connexions de la plateforme. ---
# Une variable remplie ici remplace le champ correspondant de l'écran Connexions : laissez vide (ou en commentaire) ce que vous réglez dans la plateforme.
# Envoi d'e-mails (devis, factures, avis aux clients). Port 465 (SSL) ou 587 (STARTTLS).
SMTP_HOST=
# SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Réception (les e-mails reçus deviennent des demandes)
IMAP_HOST=
# IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Assistant IA du site
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Paiement en ligne : konnect ou flouci
PAYMENT_PROVIDER=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# KONNECT_SANDBOX=false
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# ---------------------------------------------------------------------------
#  SERVICE « site » (le site client)
# ---------------------------------------------------------------------------

# Adresse de la plateforme, écrite dans config.js et autorisée par la politique de sécurité du site
FAZA_PLATFORM_URL=https://atelier.faza3d.tn
